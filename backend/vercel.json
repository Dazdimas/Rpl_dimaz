{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.6.2"
    }
  },
  "routes": [
    { "src": "/api\\.php", "dest": "/api/api.php" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/api/(api|index)\\.php", "dest": "/api/$1.php" },
    { "src": "/.*", "status": 404, "dest": "/api/404" }
  ]
}
